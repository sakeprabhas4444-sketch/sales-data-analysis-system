# Copy to .env (or just edit the .env that is already included).
#
# DB_ENGINE=auto   -> try MySQL first; if the login fails, fall back to SQLite automatically (recommended)
# DB_ENGINE=mysql  -> MySQL only (stops with a clear message if it cannot connect)
# DB_ENGINE=sqlite -> local file database, no MySQL needed
DB_ENGINE=auto

# MySQL login. DB_PASSWORD = the root password YOU chose when installing MySQL
# (MySQL Installer "Accounts and Roles" step). Leave empty if you set none. Use "quotes" if it contains #
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sales_analysis
